@model IEnumerable<Contact>
<h1 class="mt-4">Contacts</h1>

<form method="get" asp-controller="Contacts" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6 col-lg-4">
        <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="You are able to Search">
    </div>
    
    <div class="col-auto ms-auto">
        <a class="btn btn-primary" asp-controller="Contacts" asp-action="Create">Create New Contact</a>
    </div>
</form>







<div class="table-responsive">
    <table class="table table-hover aling-middle">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contact in Model)
            {
                <tr>
                    <td>@contact.FirstName</td>
                    <td>@contact.LastName</td>
                    <td>@contact.Email</td>
                    <td>@contact.Phone</td>
                    <td>
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-controller="Contacts" asp-route-id="@contact.Id">Details</a>
                        <a class="btn btn-sm btn-outline-info" asp-action="Edit" asp-controller="Contacts" asp-route-id="@contact.Id">Update</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-controller="Contacts" asp-route-id="@contact.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
